# ==============================================================================
# UNM-Server 3.0.1 全局生产与开发环境变量配置文件 (所有配置项统一从此文件获取)
# 
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务配置 (Server Runtime)
# ------------------------------------------------------------------------------
# 服务监听主机/IP 地址（默认 127.0.0.1 本地回环，如需暴露公网可设为 0.0.0.0）
HOST=127.0.0.1

# 服务监听端口号（1-65535，默认 5678）
PORT=5678

# 运行环境模式（production / development / test）
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. 跨域安全与域名访问控制 (CORS & Domain Guard)
# ------------------------------------------------------------------------------
# 允许访问 API 的来源域名（* 为允许所有来源；多个域名使用英文逗号分隔）
# 示例: ALLOWED_DOMAIN='https://music.example.com,http://localhost:3000'
ALLOWED_DOMAIN='*'

# ------------------------------------------------------------------------------
# 3. GD Studio 核心音乐 API 引擎 (GD Studio Music API)
# ------------------------------------------------------------------------------
# GD Studio 官方 API 服务端点（必须为完整有效 URL）
GDSTUDIO_API_URL='https://music-api.gdstudio.xyz/api.php'

# ------------------------------------------------------------------------------
# 4. 网络传输与反向代理 (Network & Proxy)
# ------------------------------------------------------------------------------
# 上游接口请求超时时间（单位：毫秒，默认 10000ms）
REQUEST_TIMEOUT=10000

# 音频直链反向代理前缀（选填；若需将音源 http 直链转为 https 代理传输可填写）
# 示例: PROXY_URL='https://proxy.example.com/'
PROXY_URL=''

# ------------------------------------------------------------------------------
# 5. 高性能内存缓存策略与生命周期 (LRU Cache Strategy & TTLs)
# ------------------------------------------------------------------------------
# 内存中最大缓存条目数量上限（默认 2000，超出自动按 LRU 算法淘汰）
CACHE_MAX_SIZE=2000

# 音频播放直链缓存有效时间（毫秒，默认 2 小时 = 7200000）
CACHE_TTL_AUDIO=7200000

# 搜索结果缓存有效时间（毫秒，默认 30 分钟 = 1800000）
CACHE_TTL_SEARCH=1800000

# 歌词缓存有效时间（毫秒，默认 12 小时 = 43200000）
CACHE_TTL_LYRIC=43200000

# 专辑封面图缓存有效时间（毫秒，默认 24 小时 = 86400000）
CACHE_TTL_PICTURE=86400000

# 歌单歌曲 ID 列表缓存有效时间（毫秒，默认 2 小时 = 7200000）
CACHE_TTL_PLAYLIST=7200000

# 歌曲详情元数据缓存有效时间（毫秒，默认 24 小时 = 86400000）
CACHE_TTL_SONG_DETAIL=86400000

# ------------------------------------------------------------------------------
# 6. 音频与业务默认行为 (Audio & Business Defaults)
# ------------------------------------------------------------------------------
# 默认音频码率（128 / 192 / 320 / 740 / 999，默认 320）
DEFAULT_BITRATE=320

# 默认专辑封面尺寸（300 / 500，默认 300）
DEFAULT_PICTURE_SIZE=300

# 默认搜索结果返回数量（1-100，默认 20）
DEFAULT_SEARCH_COUNT=20

# 默认搜索音源平台（netease / kugou / kuwo / joox / bilibili / migu / qq）
DEFAULT_SEARCH_SOURCE='netease'

# 默认直链获取音源（joox / netease / kuwo / kugou / bilibili）
DEFAULT_AUDIO_SOURCE='joox'

# 默认 /test 接口测试歌曲 ID（周杰伦 - 最伟大的作品）
DEFAULT_TEST_SONG_ID='158616'

# ------------------------------------------------------------------------------
# 7. UNM 引擎调度与音源优先级 (UNM Providers & Decrypt Policies)
# ------------------------------------------------------------------------------
# 歌曲默认解灰音源列表与优先级顺序（英文逗号分隔）
# 支持全部音源: gdstudio, pyncmd, bodian, joox, kugou, kuwo, bilivideo, bilibili, ytdlp, migu, qq, youtubedl, youtube
DEFAULT_MATCH_SERVERS='gdstudio,pyncmd,bodian,joox,kugou,kuwo,bilivideo,bilibili'

# 是否启用无损 FLAC 音质支持（true / false）
ENABLE_FLAC=true

# 是否自动选择最高音质（true / false）
SELECT_MAX_BR=true

# 是否严格遵循音源配置顺序（true / false，默认 false 为并发智能竞速）
FOLLOW_SOURCE_ORDER=false

# 是否在单曲匹配失败时尝试专辑全量检索（true / false）
SEARCH_ALBUM=true

# ------------------------------------------------------------------------------
# 8. 可选第三方音乐平台认证凭据 (Optional Provider Cookies)
# ------------------------------------------------------------------------------
# QQ音乐 Cookie（选填，用于提升 QQ 音乐接口解析成功率与音质）
QQ_COOKIE=''

# JOOX Cookie（选填，当前已由 GD Studio 引擎提供免 Cookie 稳定解析）
JOOX_COOKIE=''

# 咪咕音乐 Cookie（选填）
MIGU_COOKIE=''

# 酷我音乐 Cookie（选填）
KUWO_COOKIE=''

# ------------------------------------------------------------------------------
# 9. 安全加固与防护策略 (Security Guard & Rate Limiting)
# ------------------------------------------------------------------------------
# 监控与管理接口访问密钥（必填；/api/monitor/* 与清空接口必须携带 x-api-key 或 ?api_key；留空则进程拒绝启动）
MONITOR_SECRET_KEY=''

# 是否启用 API 请求速率限制（true / false，默认 true）
ENABLE_RATE_LIMIT=true

# 速率限制滑动统计窗口（单位：毫秒，默认 60000ms 即 1 分钟）
RATE_LIMIT_WINDOW_MS=60000

# 单个 IP 在统计窗口内允许的最大请求次数（默认 120 次/分钟）
RATE_LIMIT_MAX_REQUESTS=120

# 受信反向代理名单（逗号分隔，支持精确 IP 与 IPv4 CIDR，默认 127.0.0.1,::1）
# 仅当请求的直连对端属于此名单时，服务端才按 X-Forwarded-For 链解析客户端 IP；
# 若服务直连公网（无反向代理），保持默认即可，客户端伪造的 XFF 将被忽略。
# 注意：受信代理场景下不再采信 cf-connecting-ip / true-client-ip 等平台边缘头
# （普通反代不会覆盖它们，可被客户端伪造）；Cloudflare 等 CDN 回源时请把
# CDN 边缘 IP 段加入此名单，否则客户端 IP 归因坍缩到 CDN 边缘 IP。
TRUSTED_PROXIES='127.0.0.1,::1'

# Cloudflare 回源场景（2026-09-26 自 https://www.cloudflare.com/ips-v4 拉取，
# 官方偶尔更新，过期请重拉）：把下面一行的注释去掉即可启用。
# 注意：解析器仅支持 IPv4 CIDR；IPv6 段（2400:cb00::/32 等）暂不支持，
# 加入会触发 fail-loud 告警并被丢弃，纯 IPv6 回源请走其他受信方式。
#TRUSTED_PROXIES='127.0.0.1,::1,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22'

# Cloudflare 边缘 IP 自动更新（推荐：免手动维护上面的静态段）
# 开启后进程启动时从官方 URL 拉取 IPv4 段并每 24 小时刷新一次，
# 内存合并进受信代理表（不写 .env）；下发列表经严格校验，
# 失败时沿用上次有效列表。默认关闭。
CF_AUTO_TRUSTED_IPS=false
# 拉取地址（必须 https，防中间人投毒改写受信表）
CF_TRUSTED_IPS_URL='https://www.cloudflare.com/ips-v4'
# 刷新间隔毫秒（默认 86400000 = 24 小时，允许 1 小时 ~ 7 天）
CF_TRUSTED_IPS_INTERVAL_MS=86400000
