{
  "name": "unm-server",
  "version": "2.0.0",
  "description": "网易云解灰与跨平台音乐 API 服务 (Hono + TypeScript Modern Edition)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "prd": "pm2 start dist/index.js --name unm-server",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "author": "imsyy",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@unblockneteasemusic/server": "0.28.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.30.3"
}
